# Copy to .env (never commit .env). Values here are placeholders or safe defaults only.

# Database: Supabase *session pooler* connection string (port 5432). Required.
DATABASE_URL=

# Django
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
COMPANY_STATE=Gujarat

# Email: leave empty to write emails to backend/sent_emails/; set to mailpit (Docker) or an SMTP host
EMAIL_HOST=
EMAIL_PORT=1025

# Public API
API_KEY_PEPPER=
API_KEY_RATE=120/min

# Demo seed password for the @brightloop.test users (optional)
DEMO_PASSWORD=

# Supabase project (not used by the app today; kept for tooling)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
